# Portal Mayorista - configuración

# Clave de sesión Flask (generar: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=cambiar_por_clave_larga_y_aleatoria

FLASK_DEBUG=false

# URL base del sistema principal (comenda-sistema) para la API interna.
# En la VPS, ambos servicios corren en el mismo host: usar el puerto local.
COMENDA_API_URL=http://127.0.0.1:5000

# API key interna — DEBE ser idéntica a la de comenda-sistema/.env
INTERNAL_API_KEY=cambiar_misma_clave_que_comenda_sistema

# Puerto del servicio (systemd / gunicorn)
PORT=5001

# Recuperación de contraseña: mientras no haya un servicio de mail real
# conectado, en true loguea el link de reset en vez de fallar (ver
# services/mailer.py). Dejar en false (o sin definir) en producción salvo
# que se sepa exactamente por qué se lo está prendiendo.
RESET_LOG_LINK_FALLBACK=false

# Proveedor de mail real para el link de recuperación (D1.h) — sin definir
# todavía. Mientras SMTP_HOST esté vacío, /recuperar muestra el mensaje de
# "escribinos al WhatsApp" en vez de intentar mandar nada. Cuando se cargue
# esto, avisar para conectar el envío real en services/mailer.py.
#SMTP_HOST=
#SMTP_PORT=
#SMTP_USER=
#SMTP_PASSWORD=
#MAIL_REMITENTE=
#MAIL_REMITENTE_NOMBRE=
